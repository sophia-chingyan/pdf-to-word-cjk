# Required
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=you@gmail.com
# SESSION_SECRET: a random string, e.g. from `openssl rand -hex 32`
SESSION_SECRET=

# Where the database and files live. On Railway, attach a volume at /data.
DATA_DIR=/data

# Optional: backup conversion through ConvertAPI (https://www.convertapi.com)
CONVERT_API_KEY=

# Optional: public origin, e.g. https://pdf.example.com. On Railway the
# generated domain is used automatically.
APP_BASE_URL=

# Local development only (ignored on Railway): skip Google sign-in.
# AUTH_DISABLED=1
